FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    git \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

RUN pip install --no-cache-dir --timeout 300 fastapi uvicorn sentence-transformers

RUN python3 -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('BAAI/bge-small-en-v1.5')"

COPY dispatcher.py .

EXPOSE 7997

CMD ["uvicorn", "dispatcher:app", "--host", "0.0.0.0", "--port", "7997"]